{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "share": "manual",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "formatter": {
    "dart": {
      "command": ["dart", "format", "$FILE"],
      "extensions": [".dart"]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "engram": {
      "type": "local",
      "command": [
        "C:\\Users\\HACKTU\\go\\bin\\engram.exe",
        "mcp",
        "--project=numix",
        "--tools=agent"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".dart_tool/**",
      "build/**",
      ".git/**",
      ".gradle/**",
      "**/.gradle/**"
    ]
  }
}
